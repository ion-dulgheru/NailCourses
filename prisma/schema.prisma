generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String           @default("No Name")
  surname       String          @default("No Surname")
  email         String          @unique
  emailVerified DateTime?       @db.Timestamp(6)
  image         String?
  password      String?
  role          String          @default("elev")
  address       Json?            @db.Json
  paymentMethod String?
  telefon       String?   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts      Account[]
  sessions      Session[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  orders         Order[]
  certificates   Certificate[]
}

// ─── Cursuri ────────────────────────────────────────────────────────────────

enum CourseLevel {
  incepator
  intermediar
  avansat
}

enum CourseStatus {
  ciorna
  publicat
}

model Course {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String       @unique
  title            String
  category         String       @default("")
  shortDescription String       // promisiunea într-o frază (carduri, antet)
  longDescription  String       @default("")
  level            CourseLevel
  priceMdl         Int          // lei întregi
  coverImage       String
  coverAlt         String       @default("")
  whatYouLearn     String[]
  forWho           String[]
  materials        String[]
  status           CourseStatus @default(ciorna)
  position         Int          @default(0) // ordinea în catalog / pe Acasă
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  lessons      Lesson[]
  enrollments  Enrollment[]
  orders       Order[]
  certificates Certificate[]

  @@index([status, position])
}

model Lesson {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String   @db.Uuid
  slug            String
  title           String
  description     String   @default("")
  position        Int
  durationSeconds Int      @default(0)
  isFreePreview   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  blocks   LessonBlock[]

  @@unique([courseId, slug])
  @@index([courseId, position])
}

enum LessonBlockType {
  titlu
  text
  video
  pdf
}

// Conținutul unei lecții, compus de admin din blocuri ordonate (titlu, text, video, pdf).
model LessonBlock {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String          @db.Uuid
  position  Int
  type      LessonBlockType
  text      String          @default("") // titlul, paragraful, legenda video-ului sau numele PDF-ului
  videoKey  String?         // `video`: link YouTube sau cheia din R2; `pdf`: cheia fișierului din R2
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}

// ─── Acces, progres, comenzi ────────────────────────────────────────────────

enum EnrollmentSource {
  plata
  manual
}

// Singura sursă de adevăr pentru „cine are acces la ce curs”.
model Enrollment {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  courseId  String           @db.Uuid
  source    EnrollmentSource
  orderId   String?          @unique @db.Uuid
  grantedAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
}

model LessonProgress {
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

enum OrderStatus {
  in_asteptare
  platita
  esuata
  rambursata
}

model Order {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String      @db.Uuid
  courseId          String      @db.Uuid
  amountMdl         Int         // prețul copiat la momentul cumpărării
  status            OrderStatus @default(in_asteptare)
  maibTransactionId String?     @unique
  createdAt         DateTime    @default(now())
  paidAt            DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Certificate {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @db.Uuid
  courseId String   @db.Uuid
  code     String   @unique
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
}

// Date firmă, contact, text certificat (cheie → valoare).
model Setting {
  key   String @id
  value String
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  createdAt DateTime @default(now())   @db.Timestamp(6)
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime  @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())  @db.Timestamp(6)
  updatedAt DateTime @updatedAt
}